# Forge environment schema
#
# Single source of truth for every environment variable the Forge server and
# CLI read. AI agents can read this file for full configuration context without
# ever seeing secret values.
#
# Resolution order (low to high): defaults below, `.env` (legacy), `.env.local`
# (git-ignored local overrides), process environment variables. Real secrets
# belong in `.env.local`; never commit them.
#
# @defaultRequired=false @defaultSensitive=false
# ---

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# Port the HTTP API listens on
# @type=port @example=8787
PORT=8787

# Interface the HTTP API binds to
# @type=string @example=0.0.0.0
HOST=0.0.0.0

# Bucket name reported by the API for site assets
# @type=string
SITE_BUCKET=forge-sites

# Filesystem root for uploaded site assets
# @type=string
STORAGE_ROOT=./data

# Filesystem root for per-site SQLite databases
# @type=string
DATABASE_ROOT=./data/db

# How long an idle per-site SQLite connection is kept open, in milliseconds
# @type=number(isInt=true, min=0)
SITE_DB_IDLE_TTL_MS=300000

# Maximum size of a single uploaded asset, in bytes
# @type=number(isInt=true, min=1)
UPLOAD_MAX_BYTES=10000000

# Whether the background cron job runner is enabled
# @type=boolean
JOB_RUNNER_ENABLED=true

# How often the job runner scans for due jobs, in milliseconds
# @type=number(isInt=true, min=1000)
JOB_RUNNER_INTERVAL_MS=30000

# Maximum number of migrations accepted in a single `db push`
# @type=number(isInt=true, min=1)
DB_MIGRATION_MAX_COUNT=100

# Maximum size of a single migration file, in bytes
# @type=number(isInt=true, min=1)
DB_MIGRATION_MAX_BYTES=1000000

# Maximum size of a migration bundle, in bytes
# @type=number(isInt=true, min=1)
DB_MIGRATION_MAX_BUNDLE_BYTES=5000000

# Maximum time a migration may run, in milliseconds
# @type=number(isInt=true, min=1)
DB_MIGRATION_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# Webhook gateway
# -----------------------------------------------------------------------------

# External API that webhooks and scheduled jobs are forwarded to. When unset,
# the gateway is disabled.
# @type=url
# @docs(https://github.com/ism0080/forge)
EXTERNAL_API_URL=

# Credential sent to the external webhook API as a bearer token
# @type=string
# @sensitive
EXTERNAL_API_KEY=

# -----------------------------------------------------------------------------
# CLI
# -----------------------------------------------------------------------------

# Base URL used by the `forge` CLI when talking to the API
# @type=url
FORGE_API_BASE_URL=https://media-svr.stingray-goby.ts.net:1234
