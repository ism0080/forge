{
  "name": "@ism0080/forge-core",
  "version": "0.3.4",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "publish:local": "pnpm build && pnpm publish --registry http://localhost:4873 --no-git-checks --tag local"
  },
  "dependencies": {
    "effect": "4.0.0-rc.115"
  }
}
