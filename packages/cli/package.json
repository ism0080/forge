{
  "name": "@ism0080/forge-cli",
  "version": "0.3.4",
  "bin": {
    "forge": "dist/index.js"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "dev": "tsx src/index.ts",
    "publish:local": "pnpm build && pnpm publish --registry http://localhost:4873 --no-git-checks --tag local"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.115",
    "@ism0080/forge-core": "workspace:*",
    "@ism0080/forge-sdk": "workspace:*",
    "@ism0080/forge-templates": "workspace:*",
    "effect": "4.0.0-rc.115"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13"
  }
}
