{
  "name": "@ism0080/forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev:api": "varlock run -- pnpm --filter @ism0080/forge-server dev",
    "dev:cli": "pnpm --filter @ism0080/forge-cli dev",
    "docker": "varlock run -- docker compose up -d",
    "docker:new": "varlock run -- docker compose up --force-recreate --build -d",
    "env:check": "varlock load",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.tests.json",
    "test": "node scripts/versions.mjs check && vitest run",
    "test:watch": "vitest",
    "prepare": "effect-language-service patch",
    "cli:global": "pnpm --filter @ism0080/forge-cli build && pnpm add -g ./packages/cli",
    "cli:link": "pnpm --filter @ism0080/forge-cli build && pnpm --dir packages/cli link --global",
    "lint": "oxlint --config oxlint.config.ts",
    "format": "oxfmt",
    "version:check": "node scripts/versions.mjs check",
    "version:all": "node scripts/versions.mjs bump",
    "publish:all": "pnpm version:all && pnpm -r --if-present publish:local && node scripts/versions.mjs tag"
  },
  "dependencies": {
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.2",
    "@effect/vitest": "4.0.0-rc.115",
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/node": "^26.5.1",
    "typescript": "^5.9.3",
    "varlock": "^1.19.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@10.12.1"
}
